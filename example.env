# .env
RESO_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
RESO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or OAuth2 client credentials (used instead of RESO_TOKEN when RESO_CLIENT_ID is set)
# RESO_CLIENT_ID=your-client-id
# RESO_CLIENT_SECRET=your-client-secret
# RESO_TOKEN_URI=https://auth.example.com/oauth/token
# RESO_SCOPE=api
# RESO_CREDENTIAL_TRANSPORT=body   # body (default), header or query
RESO_DATASET_ID=actris_ref
RESO_TIMEOUT=30
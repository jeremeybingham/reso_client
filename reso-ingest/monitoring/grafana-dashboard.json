{
  "title": "reso-ingest",
  "uid": "reso-ingest",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "reso"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Freshness lag (newest ModificationTimestamp written)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_freshness_lag_seconds",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Last run succeeded (1 = yes)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_success",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Records per second, last run",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_records_per_second",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Records written, last run",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_records",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Run duration",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_duration_seconds",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by class, last run",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_responses",
          "legendFormat": "{{server}}/{{resource}} {{class}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retries, last run",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_retries",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Response bytes, last run",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_last_run_http_bytes",
          "legendFormat": "{{server}}/{{resource}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Servers that failed as a whole",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "reso_ingest_server_failed",
          "legendFormat": "{{server}}"
        }
      ]
    }
  ]
}
